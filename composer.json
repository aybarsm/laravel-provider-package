{
    "name": "aybarsm/laravel-provider-package",
    "version": "dev-main",
    "description": "An opinionated, extended version of Spatie laravel-package-tools to configure Laravel Service Providers.",
    "type": "library",
    "license": "MIT",
    "keywords": ["aybarsm", "php", "laravel", "service-providers", "service", "provider"],
    "homepage": "https://www.github.com/aybarsm/laravel-provider-package",
    "support": {
        "email": "dev@blrm.net"
    },
    "authors": [
        {
            "name": "Murat Aybars",
            "email": "murat.aybars@blrm.net",
            "homepage": "https://www.blrm.net",
            "role": "Founder"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "Aybarsm\\Laravel\\ProviderPackage\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
